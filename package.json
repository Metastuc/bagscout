{
    "name": "bagscout",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "build": "bunx --bun vite build",
        "db:generate": "bunx --bun drizzle-kit generate",
        "db:migrate": "bunx --bun drizzle-kit migrate",
        "db:studio": "bunx --bun drizzle-kit studio",
        "dev": "bunx --bun vite dev",
        "format": "bunx oxfmt",
        "jobs": "bun run ./src/jobs/index.ts",
        "lint": "bunx --bun oxlint --type-aware --type-check --fix .",
        "preview": "bunx --bun vite preview",
        "start": "bun run server.ts",
        "test": "bunx --bun vitest run"
    },
    "dependencies": {
        "@bagsfm/bags-sdk": "^1.3.6",
